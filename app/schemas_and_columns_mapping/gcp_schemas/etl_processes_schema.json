[
  {
    "name": "run_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Unique identifier for this ETL run"
  },
  {
    "name": "run_timestamp",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
    "description": "When the ETL process started"
  },
  {
    "name": "process_name",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Name of the ETL process (e.g., CMS_PROVIDERS_ETL)"
  },
  {
    "name": "filters_applied",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "Filter values used (states, specialties)"
  },
  {
    "name": "records_extracted",
    "type": "INTEGER",
    "mode": "REQUIRED",
    "description": "Total records extracted from API"
  },
  {
    "name": "clinicians_records",
    "type": "INTEGER",
    "mode": "REQUIRED",
    "description": "Records loaded to clinicians table"
  },
  {
    "name": "locations_records",
    "type": "INTEGER",
    "mode": "REQUIRED",
    "description": "Records loaded to practice_locations table"
  },
  {
    "name": "valid_records",
    "type": "INTEGER",
    "mode": "REQUIRED",
    "description": "Records that passed validation (is_valid_record=TRUE)"
  },
  {
    "name": "invalid_records",
    "type": "INTEGER",
    "mode": "REQUIRED",
    "description": "Records that failed validation (is_valid_record=FALSE)"
  },
  {
    "name": "status",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Pipeline status (success, failed, partial)"
  },
  {
    "name": "duration_seconds",
    "type": "FLOAT64",
    "mode": "REQUIRED",
    "description": "Total execution time in seconds"
  },
  {
    "name": "error_message",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "Error message if process failed"
  },
  {
    "name": "load_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Load batch identifier (matches data tables)"
  },
  {
    "name": "include_invalid",
    "type": "BOOLEAN",
    "mode": "REQUIRED",
    "description": "Whether invalid records were included in load"
  }
]